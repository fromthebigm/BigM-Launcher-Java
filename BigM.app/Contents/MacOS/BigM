#!/bin/sh
set -e
DIR="$(CDPATH= cd "$(dirname "$0")/../../.." && pwd -P)"
exec "$DIR/jdk/Contents/Home/bin/java" \
  -XstartOnFirstThread \
  --enable-native-access=ALL-UNNAMED \
  -Xdock:name="BigM" \
  -Xdock:icon="$DIR/Resources/BigM.icns" \
  -XX:ErrorFile="$DIR/portable-data/profile/hs_err_pid%p.log" \
  -Dbigm.root="$DIR" \
  -cp "$DIR/target/bigm.jar:$DIR/lib/*" \
  BigMApp "$@"
